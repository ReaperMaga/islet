{
  "name": "islet",
  "displayName": "Islet",
  "description": "GitHub issues and pull requests for the repository you're working in, in a calm Islands-style panel.",
  "version": "0.8.0",
  "publisher": "reapermaga",
  "author": "ReaperMaga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReaperMaga/islet.git"
  },
  "bugs": "https://github.com/ReaperMaga/islet/issues",
  "homepage": "https://github.com/ReaperMaga/islet#readme",
  "keywords": [
    "github",
    "issues",
    "pull requests",
    "code review",
    "islands"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "islet",
          "title": "GitHub",
          "icon": "media/github.svg"
        }
      ]
    },
    "views": {
      "islet": [
        {
          "id": "islet.sidebar",
          "name": "Issues & Pull Requests",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "islet.refresh",
        "title": "Refresh",
        "category": "Islet",
        "icon": "$(refresh)"
      },
      {
        "command": "islet.signIn",
        "title": "Sign in to GitHub",
        "category": "Islet"
      },
      {
        "command": "islet.openItem",
        "title": "Open Issue or Pull Request…",
        "category": "Islet"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "islet.refresh",
          "when": "view == islet.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node build.mjs --production && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
